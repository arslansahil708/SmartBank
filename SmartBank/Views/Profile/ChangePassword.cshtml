@model SmartBank.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<style>
    .password-page {
        --navy: #102b46;
        --gold: #c9a44c;
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 35px 12px;
    }

    .password-card {
        width: 100%;
        max-width: 490px;
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 19px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(16,43,70,.09);
    }

    .password-header {
        background: linear-gradient(120deg, #102b46, #234e70);
        color: white;
        padding: 30px;
        text-align: center;
    }

    .password-icon {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        margin: 0 auto 15px;
        background: rgba(255,255,255,.13);
        color: #e4c36e;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 29px;
    }

    .password-body {
        padding: 30px;
    }

    .password-label {
        color: #263d53;
        font-weight: 650;
        font-size: 13px;
        margin-bottom: 8px;
    }

    .password-input-group {
        position: relative;
    }

        .password-input-group .form-control {
            height: 48px;
            border: 1px solid #dce3eb;
            border-radius: 9px;
            padding: 10px 45px 10px 43px;
            font-size: 14px;
        }

            .password-input-group .form-control:focus {
                border-color: var(--gold);
                box-shadow: 0 0 0 3px rgba(201,164,76,.13);
            }

    .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #8493a3;
        z-index: 2;
    }

    .toggle-password {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #78899a;
        cursor: pointer;
        z-index: 3;
    }

    .btn-change {
        background: var(--navy);
        color: white;
        border: none;
        border-radius: 9px;
        padding: 12px 18px;
        font-weight: 650;
        transition: .2s;
    }

        .btn-change:hover {
            background: #234e70;
            color: white;
            transform: translateY(-1px);
        }

    .btn-cancel {
        border: 1px solid #dce3eb;
        color: #536579;
        background: white;
        border-radius: 9px;
        padding: 12px 18px;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
    }

        .btn-cancel:hover {
            background: #f3f5f8;
            color: #102b46;
        }

    .security-note {
        background: #fbf7eb;
        border: 1px solid #f0e5c9;
        border-radius: 10px;
        padding: 13px;
        color: #806b3e;
        font-size: 12px;
        line-height: 1.6;
    }

    @@media (max-width: 480px) {
        .password-body {
            padding: 22px;
        }

        .password-header {
            padding: 25px 18px;
        }
    }
</style>

<div class="password-page">

    <div class="password-card">

        <!-- Header -->
        <div class="password-header">

            <div class="password-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <h3 class="fw-bold mb-2">Change Password</h3>

            <p class="text-white-50 mb-0 small">
                Keep your SmartBank account secure.
            </p>

        </div>

        <!-- Form -->
        <div class="password-body">

            <div class="mb-4">
                <h5 class="fw-bold mb-1" style="color:#102b46;">
                    Update Your Password
                </h5>
                <p class="text-muted small mb-0">
                    Enter your current password and choose a new one.
                </p>
            </div>

            <form asp-action="ChangePassword" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3">
                </div>

                <!-- Current Password -->
                <div class="mb-3">

                    <label asp-for="CurrentPassword"
                           class="form-label password-label">
                    </label>

                    <div class="password-input-group">
                        <i class="bi bi-lock input-icon"></i>

                        <input asp-for="CurrentPassword"
                               type="password"
                               class="form-control password-field"
                               placeholder="Enter current password"
                               autocomplete="current-password" />

                        <button type="button"
                                class="toggle-password"
                                aria-label="Show or hide password"
                                onclick="togglePassword(this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="CurrentPassword"
                          class="text-danger small">
                    </span>

                </div>

                <!-- New Password -->
                <div class="mb-3">

                    <label asp-for="NewPassword"
                           class="form-label password-label">
                    </label>

                    <div class="password-input-group">
                        <i class="bi bi-key input-icon"></i>

                        <input asp-for="NewPassword"
                               type="password"
                               class="form-control password-field"
                               placeholder="Enter new password"
                               autocomplete="new-password" />

                        <button type="button"
                                class="toggle-password"
                                aria-label="Show or hide password"
                                onclick="togglePassword(this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="NewPassword"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Confirm Password -->
                <div class="mb-4">

                    <label asp-for="ConfirmPassword"
                           class="form-label password-label">
                    </label>

                    <div class="password-input-group">
                        <i class="bi bi-shield-check input-icon"></i>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control password-field"
                               placeholder="Confirm new password"
                               autocomplete="new-password" />

                        <button type="button"
                                class="toggle-password"
                                aria-label="Show or hide password"
                                onclick="togglePassword(this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Security Note -->
                <div class="security-note mb-4">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Choose a strong password and never share it with anyone.
                </div>

                <!-- Buttons -->
                <div class="d-flex flex-column gap-2">

                    <button type="submit" class="btn btn-change w-100">
                        <i class="bi bi-shield-check me-2"></i>
                        Change Password
                    </button>

                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-arrow-left me-2"></i>
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(button) {

            const input = button.parentElement.querySelector(".password-field");
            const icon = button.querySelector("i");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            }
            else {
                input.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}
