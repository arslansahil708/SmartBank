@model List<SavingsPlan>

@{
    ViewData["Title"] = "Savings Plans";
    var accounts = (SelectList)ViewBag.Accounts;
}

<style>
    .savings-page {
        padding: 20px 0;
    }

    .savings-header {
        background: linear-gradient(120deg, #071d40, #123f78);
        color: white;
        border-radius: 15px;
        padding: 27px;
        margin-bottom: 25px;
    }

        .savings-header h3 {
            font-weight: 800;
            margin-bottom: 6px;
        }

        .savings-header p {
            color: #d5e1f2;
            font-size: 13px;
            margin: 0;
        }

    .create-plan-card,
    .plan-card {
        background: white;
        border: 1px solid #e3eaf3;
        border-radius: 14px;
        box-shadow: 0 5px 20px rgba(8, 35, 75, 0.06);
        overflow: hidden;
    }

    .create-plan-card {
        margin-bottom: 25px;
    }

    .card-section-header {
        padding: 18px 22px;
        border-bottom: 1px solid #e9edf4;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: #fff5d9;
        color: #a77a12;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .card-section-header h5 {
        color: #09244d;
        font-weight: 750;
        margin: 0;
    }

    .card-section-header p {
        color: #8793a5;
        font-size: 12px;
        margin: 3px 0 0;
    }

    .create-plan-body {
        padding: 22px;
    }

    .form-label-custom {
        color: #09244d;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .custom-control {
        min-height: 44px;
        border: 1px solid #dce4ef;
        border-radius: 8px;
        font-size: 13px;
    }

        .custom-control:focus {
            border-color: #1451a0;
            box-shadow: 0 0 0 3px rgba(20,81,160,0.10);
        }

    .btn-create-plan {
        background: #092f66;
        color: white;
        border: none;
        border-radius: 8px;
        min-height: 44px;
        font-weight: 700;
    }

        .btn-create-plan:hover {
            background: #1451a0;
            color: white;
        }

    .plan-card {
        margin-bottom: 20px;
        transition: 0.2s ease;
    }

        .plan-card:hover {
            box-shadow: 0 9px 24px rgba(8, 35, 75, 0.10);
        }

        .plan-card.closed-plan {
            background: #f7f8fa;
            opacity: 0.85;
        }

    .plan-body {
        padding: 23px;
    }

    .plan-title {
        color: #09244d;
        font-weight: 800;
        font-size: 18px;
        margin-bottom: 5px;
    }

    .plan-subtitle {
        color: #8793a5;
        font-size: 12px;
    }

    .closed-badge {
        background: #e4e7ec;
        color: #596579;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 750;
    }

    .plan-amount {
        color: #09244d;
        font-size: 16px;
        font-weight: 800;
    }

    .plan-progress {
        height: 11px;
        border-radius: 20px;
        background: #e9edf4;
        overflow: hidden;
    }

        .plan-progress .progress-bar {
            border-radius: 20px;
            background: linear-gradient(90deg, #087b46, #37b879);
        }

    .progress-details {
        display: flex;
        justify-content: space-between;
        color: #7b8798;
        font-size: 12px;
        font-weight: 650;
        margin-top: 8px;
        margin-bottom: 20px;
    }

    .plan-form-area {
        background: #f8faff;
        border: 1px solid #e7edf6;
        border-radius: 10px;
        padding: 17px;
    }

    .plan-form-title {
        color: #09244d;
        font-size: 13px;
        font-weight: 750;
        margin-bottom: 13px;
    }

    .btn-add-money {
        background: #087b46;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        min-height: 42px;
    }

        .btn-add-money:hover {
            background: #056238;
            color: white;
        }

    .btn-close-plan {
        border: 1px solid #dc3545;
        color: #dc3545;
        background: white;
        border-radius: 8px;
        padding: 8px 13px;
        font-size: 12px;
        font-weight: 700;
    }

        .btn-close-plan:hover {
            background: #dc3545;
            color: white;
        }

    .empty-plans {
        background: white;
        border: 1px solid #e3eaf3;
        border-radius: 14px;
        padding: 45px 20px;
        text-align: center;
        color: #8793a5;
    }

        .empty-plans i {
            font-size: 45px;
            color: #c5d2e4;
        }

        .empty-plans h5 {
            color: #09244d;
            font-weight: 750;
            margin-top: 12px;
        }

    @@media (max-width: 576px) {
        .savings-header {
            padding: 21px;
        }

        .create-plan-body,
        .plan-body {
            padding: 17px;
        }

        .plan-amount {
            font-size: 14px;
        }

        .plan-form-area .btn-add-money {
            width: 100%;
        }
    }
</style>

<div class="container savings-page">

    <!-- Page Header -->
    <div class="savings-header">

        <h3>
            <i class="bi bi-piggy-bank me-2"></i>
            Savings Plans
        </h3>

        <p>
            Create savings goals, add money and track your financial progress.
        </p>

    </div>

    <!-- Create New Plan -->
    <div class="create-plan-card">

        <div class="card-section-header">

            <div class="section-icon">
                <i class="bi bi-plus-circle"></i>
            </div>

            <div>
                <h5>Create a New Plan</h5>
                <p>Set a savings goal and start building your future.</p>
            </div>

        </div>

        <div class="create-plan-body">

            <form asp-action="CreatePlan" method="post" class="row g-3">

                @Html.AntiForgeryToken()

                <div class="col-md-5">

                    <label class="form-label-custom">
                        <i class="bi bi-pencil-square me-1 text-warning"></i>
                        Plan Name
                    </label>

                    <input name="name"
                           class="form-control custom-control"
                           placeholder="e.g. New Bike"
                           maxlength="50"
                           required />

                </div>

                <div class="col-md-4">

                    <label class="form-label-custom">
                        <i class="bi bi-cash-stack me-1 text-warning"></i>
                        Target Amount (Rs)
                    </label>

                    <input name="targetAmount"
                           type="number"
                           step="0.01"
                           min="1"
                           class="form-control custom-control"
                           placeholder="Enter target amount"
                           required />

                </div>

                <div class="col-md-3 d-flex align-items-end">

                    <button type="submit" class="btn btn-create-plan w-100">

                        <i class="bi bi-plus-lg me-2"></i>
                        Create Plan

                    </button>

                </div>

            </form>

        </div>

    </div>

    <!-- Existing Savings Plans -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h5 class="fw-bold mb-0" style="color:#09244d;">
            <i class="bi bi-wallet2 text-warning me-2"></i>
            My Savings Goals
        </h5>

        <span class="badge rounded-pill text-bg-light">
            @Model.Count Plan(s)
        </span>

    </div>

    @foreach (var p in Model)
    {
        decimal percent = p.TargetAmount > 0
            ? Math.Min(100, Math.Round(p.SavedAmount / p.TargetAmount * 100, 0))
            : 0;

        <div class="plan-card @(p.IsClosed ? "closed-plan" : "")">

            <div class="plan-body">

                <!-- Plan Header -->
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">

                    <div>

                        <h5 class="plan-title">

                            <i class="bi bi-bullseye text-warning me-2"></i>
                            @p.Name

                        </h5>

                        <div class="plan-subtitle">
                            Savings Goal
                        </div>

                    </div>

                    @if (p.IsClosed)
                    {
                        <span class="closed-badge">
                            <i class="bi bi-lock-fill me-1"></i>
                            Closed
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill text-bg-success">
                            Active
                        </span>
                    }

                </div>

                <!-- Amount Details -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">

                    <div class="plan-subtitle">
                        Saved Amount
                    </div>

                    <div class="plan-amount">
                        Rs @p.SavedAmount.ToString("N2")
                        <span class="text-muted fw-normal">of</span>
                        Rs @p.TargetAmount.ToString("N2")
                    </div>

                </div>

                <!-- Progress -->
                <div class="progress plan-progress mb-2">

                    <div class="progress-bar"
                         role="progressbar"
                         style="width: @percent%"
                         aria-valuenow="@percent"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>

                </div>

                <div class="progress-details">

                    <span>
                        <i class="bi bi-graph-up me-1"></i>
                        Savings Progress
                    </span>

                    <strong>@percent%</strong>

                </div>

                @if (!p.IsClosed)
                {
                    <!-- Add Money Form -->
                    <div class="plan-form-area">

                        <div class="plan-form-title">

                            <i class="bi bi-plus-circle-fill text-success me-2"></i>
                            Add Money to This Plan

                        </div>

                        <form asp-action="DepositToPlan"
                              method="post"
                              class="row g-2">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@p.Id" />

                            <div class="col-lg-4 col-md-4">

                                <select name="fromAccountId"
                                        asp-items="@accounts"
                                        class="form-select custom-control"
                                        required>

                                    <option value="">-- From account --</option>

                                </select>

                            </div>

                            <div class="col-lg-3 col-md-3">

                                <input name="amount"
                                       type="number"
                                       step="0.01"
                                       min="1"
                                       class="form-control custom-control"
                                       placeholder="Amount (Rs)"
                                       required />

                            </div>

                            <div class="col-lg-2 col-md-2">

                                <input name="pin"
                                       type="password"
                                       maxlength="4"
                                       class="form-control custom-control"
                                       placeholder="PIN"
                                       autocomplete="off"
                                       required />

                            </div>

                            <div class="col-lg-3 col-md-3">

                                <button type="submit"
                                        class="btn btn-add-money w-100">

                                    <i class="bi bi-plus-circle me-1"></i>
                                    Add Money

                                </button>

                            </div>

                        </form>

                    </div>

                    <!-- Close Plan Form -->
                    <div class="mt-3">

                        <form asp-action="ClosePlan"
                              method="post"
                              onsubmit="return confirm('Close this plan and return the money to your account?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@p.Id" />

                            <button type="submit" class="btn-close-plan">

                                <i class="bi bi-box-arrow-down me-1"></i>
                                Close Plan and Withdraw

                            </button>

                        </form>

                    </div>
                }

            </div>

        </div>
    }

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="empty-plans">

            <i class="bi bi-piggy-bank"></i>

            <h5>No Savings Plans Yet</h5>

            <p class="mb-0">
                Create your first savings plan above and start reaching your financial goals.
            </p>

        </div>
    }

</div>