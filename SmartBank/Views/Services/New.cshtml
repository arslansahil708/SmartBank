@model SmartBank.ViewModels.ServiceRequestViewModel

@{
    ViewData["Title"] = Model.Type + " Request";
}

<style>
    .service-page {
        --navy: #102b46;
        --gold: #c9a44c;
        color: #26384a;
    }

    .service-header {
        background: linear-gradient(120deg, #102b46, #234e70);
        color: white;
        border-radius: 17px;
        padding: 25px;
        position: relative;
        overflow: hidden;
    }

        .service-header::after {
            content: "";
            position: absolute;
            width: 170px;
            height: 170px;
            border: 24px solid rgba(255,255,255,.06);
            border-radius: 50%;
            right: -45px;
            top: -65px;
        }

    .service-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        background: rgba(255,255,255,.13);
        color: #e6c777;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .service-form-card {
        background: white;
        border: 1px solid #e8edf2;
        border-radius: 17px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(16,43,70,.07);
    }

    .form-card-header {
        padding: 20px 25px;
        background: #f8fafc;
        border-bottom: 1px solid #e8edf2;
    }

        .form-card-header h5 {
            color: #102b46;
            font-weight: 750;
        }

    .form-card-body {
        padding: 27px;
    }

    .service-label {
        color: #344b60;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .service-input {
        border: 1px solid #dce3eb;
        border-radius: 10px;
        padding: 11px 13px;
        font-size: 14px;
    }

        .service-input:focus {
            border-color: #c9a44c;
            box-shadow: 0 0 0 3px rgba(201,164,76,.13);
        }

    .service-hint {
        background: #f4f6f9;
        border-left: 3px solid #c9a44c;
        color: #687b8e;
        padding: 12px 14px;
        border-radius: 7px;
        font-size: 12px;
        line-height: 1.6;
        margin-top: 10px;
    }

    .btn-gold {
        background: #c9a44c;
        color: #102b46;
        border: none;
        border-radius: 9px;
        padding: 11px 20px;
        font-weight: 750;
        transition: .2s;
    }

        .btn-gold:hover {
            background: #b58d35;
            color: #102b46;
            transform: translateY(-1px);
        }

    .btn-cancel {
        border: 1px solid #dce3eb;
        color: #526477;
        border-radius: 9px;
        padding: 11px 20px;
        font-weight: 650;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #f4f6f9;
            color: #102b46;
        }

    .service-info {
        background: #fbf7eb;
        border: 1px solid #f0e5c9;
        border-radius: 11px;
        color: #806b3e;
        padding: 15px;
        font-size: 13px;
        line-height: 1.6;
    }

    .validation-summary-errors {
        background: #fff0ef;
        border: 1px solid #f2d0ce;
        border-radius: 9px;
        padding: 12px 15px;
        margin-bottom: 20px;
        font-size: 13px;
    }

        .validation-summary-errors ul {
            margin-bottom: 0;
            padding-left: 20px;
        }

    .field-validation-error {
        font-size: 12px;
        display: block;
        margin-top: 5px;
    }

    @@media(max-width:576px) {
        .service-header {
            padding: 20px;
        }

        .form-card-body {
            padding: 20px;
        }

        .form-card-header {
            padding: 18px;
        }
    }
</style>

<div class="container py-4 service-page">

    <!-- Header -->
    <div class="service-header mb-4">

        <div class="d-flex align-items-center gap-3 position-relative"
             style="z-index:1;">

            <div class="service-icon">
                <i class="bi bi-file-earmark-plus"></i>
            </div>

            <div>
                <h3 class="fw-bold mb-1">
                    @Model.Type Request
                </h3>

                <p class="text-white-50 mb-0">
                    Submit your banking service request securely.
                </p>
            </div>

        </div>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="service-form-card">

                <div class="form-card-header">

                    <h5 class="mb-1">
                        <i class="bi bi-pencil-square me-2"></i>
                        Request Information
                    </h5>

                    <small class="text-muted">
                        Please provide the required information below.
                    </small>

                </div>

                <div class="form-card-body">

                    <form asp-action="New" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Type" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger"></div>

                        @if (Model.Type != "Change Address")
                        {
                            <div class="mb-4">

                                <label asp-for="AccountId"
                                       class="service-label">
                                    <i class="bi bi-bank me-1"
                                       style="color:#c9a44c;"></i>
                                    Select Account
                                </label>

                                <select asp-for="AccountId"
                                        asp-items="@((SelectList)ViewBag.Accounts)"
                                        class="form-select service-input">

                                    <option value="">
                                        -- Select account --
                                    </option>

                                </select>

                                <span asp-validation-for="AccountId"
                                      class="text-danger field-validation-error"></span>

                                <small class="text-muted mt-2 d-block">
                                    Select the account related to your request.
                                </small>

                            </div>
                        }

                        <div class="mb-4">

                            <label asp-for="Details"
                                   class="service-label">

                                <i class="bi bi-card-text me-1"
                                   style="color:#c9a44c;"></i>

                                Request Details

                            </label>

                            <textarea asp-for="Details"
                                      class="form-control service-input"
                                      rows="4"
                                      placeholder="Enter your request details here..."></textarea>

                            @if (ViewBag.Hint != null)
                            {
                                <div class="service-hint">
                                    <i class="bi bi-info-circle me-1"></i>
                                    @ViewBag.Hint
                                </div>
                            }

                            <span asp-validation-for="Details"
                                  class="text-danger field-validation-error"></span>

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit" class="btn btn-gold flex-grow-1">

                                <i class="bi bi-send me-2"></i>
                                Submit Request

                            </button>

                            <a class="btn-cancel text-center"
                               asp-action="Index">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

            <!-- Security Information -->
            <div class="service-info mt-3">

                <i class="bi bi-shield-check me-2"></i>

                <strong>Secure Request:</strong>
                Your request will be submitted to SmartBank for review.
                You can track its status from the Banking Services page.

            </div>

        </div>

    </div>

</div>
