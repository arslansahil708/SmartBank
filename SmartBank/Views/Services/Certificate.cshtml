@{
    ViewData["Title"] = "Transaction Certificate";
}

<style>
    .certificate-page {
        --navy: #102b46;
        --gold: #c9a44c;
        color: #26384a;
    }

    .certificate-header {
        background: linear-gradient(120deg, #102b46, #234e70);
        color: white;
        border-radius: 17px;
        padding: 25px;
        position: relative;
        overflow: hidden;
    }

        .certificate-header::after {
            content: "";
            position: absolute;
            width: 170px;
            height: 170px;
            border: 24px solid rgba(255,255,255,.06);
            border-radius: 50%;
            right: -45px;
            top: -65px;
        }

    .certificate-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        background: rgba(255,255,255,.13);
        color: #e6c777;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 25px;
    }

    .certificate-card {
        background: white;
        border: 1px solid #e8edf2;
        border-radius: 17px;
        box-shadow: 0 8px 25px rgba(16,43,70,.07);
        overflow: hidden;
    }

    .certificate-card-header {
        background: #f8fafc;
        border-bottom: 1px solid #e8edf2;
        padding: 20px 24px;
    }

        .certificate-card-header h5 {
            color: #102b46;
            font-weight: 750;
        }

    .certificate-card-body {
        padding: 27px;
    }

    .certificate-label {
        color: #344b60;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .certificate-input {
        min-height: 47px;
        border: 1px solid #dce3eb;
        border-radius: 10px;
        font-size: 14px;
        padding: 10px 13px;
    }

        .certificate-input:focus {
            border-color: #c9a44c;
            box-shadow: 0 0 0 3px rgba(201,164,76,.13);
        }

    .certificate-field-icon {
        color: #c9a44c;
        margin-right: 6px;
    }

    .btn-gold {
        background: #c9a44c;
        color: #102b46;
        border: none;
        border-radius: 9px;
        font-weight: 750;
        padding: 12px 20px;
        transition: .2s;
    }

        .btn-gold:hover {
            background: #b58d35;
            color: #102b46;
            transform: translateY(-1px);
        }

    .certificate-info {
        background: #fbf7eb;
        border: 1px solid #f0e5c9;
        border-radius: 11px;
        color: #806b3e;
        padding: 15px;
        font-size: 13px;
        line-height: 1.6;
    }

    .certificate-step {
        background: #f4f6f9;
        border-radius: 11px;
        padding: 14px;
        height: 100%;
    }

    .step-number {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #102b46;
        color: #e6c777;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 750;
        margin-bottom: 9px;
    }

    @@media(max-width:576px) {
        .certificate-header {
            padding: 20px;
        }

        .certificate-card-body {
            padding: 20px;
        }

        .certificate-card-header {
            padding: 18px;
        }
    }
</style>

<div class="container py-4 certificate-page">

    <!-- Header -->
    <div class="certificate-header mb-4">

        <div class="d-flex align-items-center gap-3 position-relative"
             style="z-index:1;">

            <div class="certificate-icon">
                <i class="bi bi-file-earmark-check"></i>
            </div>

            <div>
                <h3 class="fw-bold mb-1">
                    Transaction Certificate
                </h3>

                <p class="text-white-50 mb-0">
                    Generate your digital banking transaction certificate.
                </p>
            </div>

        </div>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="certificate-card">

                <div class="certificate-card-header">

                    <h5 class="mb-1">
                        <i class="bi bi-clipboard-data me-2"></i>
                        Certificate Details
                    </h5>

                    <small class="text-muted">
                        Select your account and transaction period.
                    </small>

                </div>

                <div class="certificate-card-body">

                    <form asp-action="CertificateResult" method="get">

                        <!-- Account -->
                        <div class="mb-4">

                            <label class="certificate-label">
                                <i class="bi bi-bank certificate-field-icon"></i>
                                Select Account
                            </label>

                            <select name="accountId"
                                    asp-items="@((SelectList)ViewBag.Accounts)"
                                    class="form-select certificate-input"
                                    required>

                                <option value="">
                                    -- Select account --
                                </option>

                            </select>

                            <small class="text-muted mt-2 d-block">
                                Choose the account for which you need a certificate.
                            </small>

                        </div>

                        <!-- Date Range -->
                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="certificate-label">
                                    <i class="bi bi-calendar-event certificate-field-icon"></i>
                                    From Date
                                </label>

                                <input type="date"
                                       name="fromDate"
                                       class="form-control certificate-input"
                                       value="@DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd")"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       required />

                            </div>

                            <div class="col-md-6">

                                <label class="certificate-label">
                                    <i class="bi bi-calendar-check certificate-field-icon"></i>
                                    To Date
                                </label>

                                <input type="date"
                                       name="toDate"
                                       class="form-control certificate-input"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       required />

                            </div>

                        </div>

                        <!-- Generate Button -->
                        <div class="d-grid mt-4">

                            <button type="submit" class="btn btn-gold">

                                <i class="bi bi-file-earmark-pdf me-2"></i>
                                Generate Certificate

                            </button>

                        </div>

                    </form>

                </div>

            </div>

            <!-- Information -->
            <div class="certificate-info mt-3">

                <i class="bi bi-info-circle-fill me-2"></i>

                <strong>Important:</strong>
                Select the correct account and date range.
                Your certificate will display transaction totals
                for the selected period.

            </div>

            <!-- Steps -->
            <div class="row g-3 mt-2">

                <div class="col-4">
                    <div class="certificate-step">

                        <div class="step-number">1</div>

                        <div class="small fw-bold" style="color:#102b46;">
                            Select Account
                        </div>

                        <small class="text-muted">
                            Choose your account.
                        </small>

                    </div>
                </div>

                <div class="col-4">
                    <div class="certificate-step">

                        <div class="step-number">2</div>

                        <div class="small fw-bold" style="color:#102b46;">
                            Choose Period
                        </div>

                        <small class="text-muted">
                            Select date range.
                        </small>

                    </div>
                </div>

                <div class="col-4">
                    <div class="certificate-step">

                        <div class="step-number">3</div>

                        <div class="small fw-bold" style="color:#102b46;">
                            Generate
                        </div>

                        <small class="text-muted">
                            View your certificate.
                        </small>

                    </div>
                </div>

            </div>

        </div>

    </div>

</div>
