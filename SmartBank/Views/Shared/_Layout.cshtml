<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartBank</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            @@media print {
                nav, .no-print {
                    display: none !important;
                }
            }
    </style>
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-success">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">SmartBank</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Customers">Customers</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Accounts">Accounts</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Loans">Loans</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Requests">Requests</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Transactions">Transactions</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="AuditLogs">Audit Logs</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Reports">Reports</a></li>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Accounts</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Index">My Accounts</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Open">Open Account</a></li>
                                <li><a class="dropdown-item" asp-controller="Services" asp-action="Certificate">Transaction Certificate</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Payments</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="Transfer">Same Bank Transfer</a></li>
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="OtherBank">Other Bank Transfer</a></li>
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="Raast">Raast ID Transfer</a></li>
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="MobileLoad">Mobile Load</a></li>
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="Bills">Utility Bills</a></li>
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="BillHistory">Bill / Load History</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="Beneficiaries">Beneficiaries</a></li>
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="CreateRequest" asp-route-kind="Request">Payment Request</a></li>
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="CreateRequest" asp-route-kind="Invoice">Digital Invoice</a></li>
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="Requests">Requests &amp; Invoices</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Services</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Services" asp-action="Index">My Requests</a></li>
                                <li><a class="dropdown-item" asp-controller="Services" asp-action="New" asp-route-type="Cheque Book">Cheque Book</a></li>
                                <li><a class="dropdown-item" asp-controller="Services" asp-action="New" asp-route-type="Stop Cheque">Stop Cheque</a></li>
                                <li><a class="dropdown-item" asp-controller="Services" asp-action="New" asp-route-type="Change Address">Change Address</a></li>
                                <li><a class="dropdown-item" asp-controller="Services" asp-action="New" asp-route-type="Debit Card">Debit Card Request</a></li>
                                <li><a class="dropdown-item" asp-controller="Services" asp-action="Cards">Card Block / Unblock</a></li>
                                <li><a class="dropdown-item" asp-controller="Services" asp-action="New" asp-route-type="Account Maintenance">Account Maintenance</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Loans</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Loan" asp-action="Index">Application Status</a></li>
                                <li><a class="dropdown-item" asp-controller="Loan" asp-action="Apply" asp-route-type="Car">Car Loan</a></li>
                                <li><a class="dropdown-item" asp-controller="Loan" asp-action="Apply" asp-route-type="Home">Home Loan</a></li>
                                <li><a class="dropdown-item" asp-controller="Loan" asp-action="Apply" asp-route-type="Personal">Personal Loan</a></li>
                                <li><a class="dropdown-item" asp-controller="Loan" asp-action="Apply" asp-route-type="Business">Business Loan</a></li>
                                <li><a class="dropdown-item" asp-controller="Loan" asp-action="History">Repayment History</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Savings</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Investment" asp-action="Index">Investment Summary</a></li>
                                <li><a class="dropdown-item" asp-controller="Investment" asp-action="Plans">Savings Plans</a></li>
                                <li><a class="dropdown-item" asp-controller="Investment" asp-action="Deposits">Term Deposits</a></li>
                                <li><a class="dropdown-item" asp-controller="Investment" asp-action="Calculator">Profit Calculator</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav align-items-lg-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (!User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Notification" asp-action="Index">Notifications</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">@User.Identity!.Name</a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">My Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="ChangePassword">Change Password</a></li>
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="LoginHistory">Login History</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><span class="navbar-text me-3">@User.Identity!.Name</span></li>
                        }
                        <li class="nav-item">
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
