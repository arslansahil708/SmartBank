@model SmartBank.ViewModels.PaymentRequestViewModel

@{
    bool isInvoice = Model.Kind == "Invoice";
    ViewData["Title"] = isInvoice ? "Digital Invoice" : "Payment Request";
}

<style>
    .payment-page {
        padding: 15px 0 35px;
    }

    .bank-card {
        border: 1px solid #e5eaf0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(16, 42, 67, .08);
        background: #fff;
    }

    .bank-card-header {
        background: #102a43;
        color: white;
        padding: 23px;
        border-bottom: 4px solid #d4a84f;
    }

        .bank-card-header h4 {
            font-weight: 700;
            margin-bottom: 5px;
        }

        .bank-card-header p {
            color: #dbe5ef;
            font-size: 13px;
            margin: 0;
        }

    .bank-card-body {
        padding: 28px;
    }

    .form-label {
        color: #102a43;
        font-weight: 600;
        font-size: 14px;
    }

    .form-control, .form-select {
        border: 1px solid #dce3eb;
        border-radius: 9px;
        padding: 11px 13px;
    }

        .form-control:focus, .form-select:focus {
            border-color: #d4a84f;
            box-shadow: 0 0 0 .2rem rgba(212, 168, 79, .15);
        }

    .input-group-text {
        background: #f4f7fb;
        color: #102a43;
        border-color: #dce3eb;
        font-weight: 600;
    }

    .btn-bank {
        background: #102a43;
        color: white;
        border: 1px solid #102a43;
        border-radius: 8px;
        padding: 11px 25px;
        font-weight: 600;
    }

        .btn-bank:hover {
            background: #173f5f;
            color: white;
        }

    .btn-cancel {
        border: 1px solid #dce3eb;
        color: #475569;
        border-radius: 8px;
        padding: 11px 22px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #f4f7fb;
            color: #102a43;
        }

    .invoice-icon {
        width: 48px;
        height: 48px;
        background: rgba(212, 168, 79, .16);
        color: #d4a84f;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .info-panel {
        background: #f4f7fb;
        border-left: 4px solid #d4a84f;
        padding: 13px 15px;
        border-radius: 7px;
        font-size: 13px;
        color: #64748b;
    }

    .field-validation-error {
        font-size: 12px;
    }

    .lookup-message {
        font-size: 13px;
        margin-top: 7px;
        font-weight: 500;
    }

    @@media (max-width: 576px) {
        .bank-card-body {
            padding: 19px;
        }

        .bank-card-header {
            padding: 18px;
        }

        .form-actions {
            display: flex;
            flex-direction: column;
        }

            .form-actions a,
            .form-actions button {
                width: 100%;
                text-align: center;
            }
    }
</style>

<div class="container payment-page">

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="bank-card">

                <!-- Header -->
                <div class="bank-card-header">

                    <div class="d-flex align-items-center gap-3">

                        <div class="invoice-icon">
                            <i class="bi @(isInvoice ? "bi-receipt" : "bi-send")"></i>
                        </div>

                        <div>
                            <h4>
                                @(isInvoice ? "Create Digital Invoice" : "Request Payment")
                            </h4>

                            <p>
                                @(isInvoice
                                    ? "Generate an invoice and request payment from another account."
                                    : "Send a payment request to another SmartBank account.")
                            </p>
                        </div>

                    </div>

                </div>

                <!-- Form -->
                <div class="bank-card-body">

                    <form asp-action="CreateRequest" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Kind" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger py-2"
                             role="alert">
                        </div>

                        <!-- Requester Account -->
                        <div class="mb-4">

                            <label asp-for="RequesterAccountId" class="form-label">
                                <i class="bi bi-bank me-1"></i>
                                Your Account
                            </label>

                            <select asp-for="RequesterAccountId"
                                    asp-items="@((SelectList)ViewBag.Accounts)"
                                    class="form-select">

                                <option value="">-- Select account --</option>

                            </select>

                            <span asp-validation-for="RequesterAccountId"
                                  class="text-danger field-validation-error">
                            </span>

                        </div>

                        <!-- Payer Account -->
                        <div class="mb-4">

                            <label asp-for="PayerAccountNumber" class="form-label">
                                <i class="bi bi-person-vcard me-1"></i>
                                Payer Account Number
                            </label>

                            <input asp-for="PayerAccountNumber"
                                   class="form-control"
                                   placeholder="e.g. SB1234567890"
                                   autocomplete="off" />

                            <div id="holderName" class="lookup-message"></div>

                            <span asp-validation-for="PayerAccountNumber"
                                  class="text-danger field-validation-error">
                            </span>

                        </div>

                        <!-- Amount -->
                        <div class="mb-4">

                            <label asp-for="Amount" class="form-label">
                                <i class="bi bi-currency-rupee me-1"></i>
                                Amount
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">Rs.</span>

                                <input asp-for="Amount"
                                       type="number"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="Enter amount" />
                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger field-validation-error">
                            </span>

                        </div>

                        <!-- Description -->
                        <div class="mb-4">

                            <label asp-for="Description" class="form-label">
                                <i class="bi bi-card-text me-1"></i>
                                Description
                            </label>

                            <input asp-for="Description"
                                   class="form-control"
                                   placeholder="Enter payment details" />

                            <span asp-validation-for="Description"
                                  class="text-danger field-validation-error">
                            </span>

                        </div>

                        <!-- Invoice Due Date -->
                        @if (isInvoice)
                        {
                            <div class="mb-4">

                                <label asp-for="DueDate" class="form-label">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    Invoice Due Date
                                </label>

                                <input asp-for="DueDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="DueDate"
                                      class="text-danger field-validation-error">
                                </span>

                            </div>
                        }

                        <!-- Information -->
                        <div class="info-panel mb-4">

                            <i class="bi bi-shield-check me-2 text-success"></i>

                            Verify the payer account number before sending your
                            payment request. The account holder name will appear
                            when the account is verified.

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex flex-wrap gap-2 form-actions">

                            <button type="submit" class="btn btn-bank">
                                <i class="bi bi-send-fill me-2"></i>
                                @(isInvoice ? "Create Invoice" : "Send Request")
                            </button>

                            <a class="btn-cancel" asp-action="Requests">
                                <i class="bi bi-arrow-left me-1"></i>
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        // Payer ka account number likho to uska naam dikhta hai
        $("#PayerAccountNumber").on("blur", function () {

            var number = $(this).val().trim();
            var box = $("#holderName");

            if (!number) {
                box.text("");
                return;
            }

            box.removeClass("text-danger text-success")
                .addClass("text-muted")
                .text("Checking account...");

            $.getJSON("@Url.Action("LookupAccount", "Payment")",
                { number: number },
                function (res) {

                    if (res.found) {
                        box.removeClass("text-danger text-muted")
                            .addClass("text-success")
                            .text("Account holder: " + res.name);
                    }
                    else {
                        box.removeClass("text-success text-muted")
                            .addClass("text-danger")
                            .text("Account not found");
                    }
                }
            ).fail(function () {

                box.removeClass("text-success text-muted")
                    .addClass("text-danger")
                    .text("Unable to verify account. Please try again.");

            });
        });
    </script>
}