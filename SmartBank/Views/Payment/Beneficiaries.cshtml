@model List<Beneficiary>

@{
    ViewData["Title"] = "Beneficiaries";
}

<style>
    :root {
        --bank-navy: #102a43;
        --bank-blue: #173f5f;
        --bank-gold: #d4a84f;
        --bank-light: #f4f7fb;
    }

    .beneficiary-page {
        padding: 10px 0 30px;
    }

    .page-heading {
        color: var(--bank-navy);
        font-weight: 700;
    }

    .page-subtitle {
        color: #718096;
        font-size: 14px;
    }

    .bank-card {
        border: 1px solid #e5eaf0;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(16, 42, 67, .07);
        background: #fff;
    }

    .bank-card-header {
        background: var(--bank-navy);
        color: white;
        padding: 17px 20px;
        border-bottom: 3px solid var(--bank-gold);
    }

        .bank-card-header h5 {
            margin: 0;
            font-weight: 600;
        }

    .bank-card-body {
        padding: 22px;
    }

    .beneficiary-table thead th {
        background: var(--bank-light);
        color: var(--bank-navy);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .4px;
        padding: 13px 12px;
        white-space: nowrap;
        border-bottom: 2px solid #e2e8f0;
    }

    .beneficiary-table tbody td {
        padding: 14px 12px;
        vertical-align: middle;
        color: #334155;
        font-size: 14px;
    }

    .beneficiary-table tbody tr:hover {
        background: #f8fafc;
    }

    .form-label {
        color: var(--bank-navy);
        font-weight: 600;
        font-size: 14px;
    }

    .form-control, .form-select {
        border-radius: 8px;
        padding: 10px 12px;
        border-color: #dce3eb;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--bank-gold);
            box-shadow: 0 0 0 .2rem rgba(212, 168, 79, .15);
        }

    .btn-bank {
        background: var(--bank-navy);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 22px;
        font-weight: 600;
    }

        .btn-bank:hover {
            background: var(--bank-blue);
            color: white;
        }

    .btn-remove {
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
    }

    .beneficiary-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #edf2f7;
        color: var(--bank-navy);
        margin-right: 9px;
    }

    .empty-state {
        padding: 35px 15px !important;
        color: #718096 !important;
    }

        .empty-state i {
            display: block;
            font-size: 32px;
            color: var(--bank-gold);
            margin-bottom: 10px;
        }

    .form-hint {
        color: #718096;
        font-size: 12px;
    }

    @@media (max-width: 767px) {
        .bank-card-body {
            padding: 15px;
        }

        .beneficiary-table {
            min-width: 650px;
        }

        .page-heading {
            font-size: 23px;
        }
    }
</style>

<div class="container-fluid beneficiary-page">

    <div class="mb-4">
        <h3 class="page-heading">
            <i class="bi bi-people-fill me-2"></i>
            Beneficiary Management
        </h3>
        <p class="page-subtitle mb-0">
            Manage your saved accounts and add new beneficiaries for payments.
        </p>
    </div>

    <div class="row g-4">

        <!-- Beneficiary List -->
        <div class="col-lg-7">

            <div class="bank-card">

                <div class="bank-card-header d-flex align-items-center justify-content-between">
                    <h5>
                        <i class="bi bi-person-lines-fill me-2"></i>
                        Saved Beneficiaries
                    </h5>

                    <span class="badge bg-light text-dark">
                        @Model.Count Total
                    </span>
                </div>

                <div class="bank-card-body p-0">

                    <div class="table-responsive">
                        <table class="table beneficiary-table table-hover mb-0">

                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Bank</th>
                                    <th>Account / Raast ID</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var b in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="beneficiary-icon">
                                                <i class="bi bi-person"></i>
                                            </span>
                                            <strong>@b.Name</strong>
                                        </td>

                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @b.Type
                                            </span>
                                        </td>

                                        <td>@b.BankName</td>

                                        <td>
                                            <span class="text-break">@b.AccountNumber</span>
                                        </td>

                                        <td>
                                            <form asp-action="DeleteBeneficiary"
                                                  method="post"
                                                  onsubmit="return confirm('Remove this beneficiary?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="id" value="@b.Id" />

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm btn-remove">
                                                    <i class="bi bi-trash3 me-1"></i>
                                                    Remove
                                                </button>

                                            </form>
                                        </td>
                                    </tr>
                                }

                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center empty-state">
                                            <i class="bi bi-person-plus"></i>
                                            <strong>No beneficiaries saved yet.</strong>
                                            <div class="small mt-1">
                                                Add your first beneficiary using the form.
                                            </div>
                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

        <!-- Add Beneficiary -->
        <div class="col-lg-5">

            <div class="bank-card">

                <div class="bank-card-header">
                    <h5>
                        <i class="bi bi-person-plus-fill me-2"></i>
                        Add Beneficiary
                    </h5>
                </div>

                <div class="bank-card-body">

                    <p class="page-subtitle mb-4">
                        Save an account to make future transfers easier.
                    </p>

                    <form asp-action="AddBeneficiary" method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">
                                Beneficiary Type
                            </label>

                            <select name="type" id="type" class="form-select">
                                <option value="SameBank">Same Bank (SmartBank account)</option>
                                <option value="Raast">Raast ID</option>
                                <option value="OtherBank">Other Bank</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" id="numberLabel">
                                Account Number
                            </label>

                            <input name="accountNumber"
                                   class="form-control"
                                   placeholder="Enter account number"
                                   required />

                            <div class="form-hint mt-2" id="numberHint">
                                Name is verified automatically for SmartBank accounts and Raast IDs.
                            </div>
                        </div>

                        <div id="otherFields" style="display:none;">

                            <div class="mb-3">
                                <label class="form-label">
                                    Bank
                                </label>

                                <select name="bankName" class="form-select">
                                    <option value="">-- Select bank --</option>

                                    @foreach (var bank in (SelectList)ViewBag.Banks)
                                    {
                                        <option value="@bank.Value">@bank.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Account Title (Name)
                                </label>

                                <input name="name"
                                       class="form-control"
                                       placeholder="Enter account holder name" />
                            </div>

                        </div>

                        <button type="submit" class="btn btn-bank w-100 mt-2">
                            <i class="bi bi-plus-circle me-2"></i>
                            Add Beneficiary
                        </button>

                    </form>

                </div>
            </div>

            <div class="mt-3 p-3 rounded-3"
                 style="background:#f4f7fb; border-left:4px solid #d4a84f;">

                <div class="d-flex gap-2">
                    <i class="bi bi-shield-check text-success fs-5"></i>
                    <div>
                        <strong class="text-dark small">Secure Beneficiary Management</strong>
                        <p class="text-muted small mb-0 mt-1">
                            Always verify account details before adding a beneficiary.
                        </p>
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        // Type ke hisaab se form ke fields badalte hain
        $("#type").on("change", function () {

            var t = $(this).val();

            $("#otherFields").toggle(t === "OtherBank");

            $("#numberLabel").text(
                t === "Raast" ? "Raast ID (mobile number)" :
                    t === "OtherBank" ? "Account Number / IBAN" :
                        "Account Number"
            );

            $("#numberHint").text(
                t === "Raast" ? "Enter the mobile number linked with Raast ID." :
                    t === "OtherBank" ? "Enter the receiver's bank account number or IBAN." :
                        "Name is verified automatically for SmartBank accounts and Raast IDs."
            );
        });
    </script>
}