@model SmartBank.ViewModels.OtherBankTransferViewModel

@{
    ViewData["Title"] = "Other Bank Transfer";
    var beneficiaries = (List<Beneficiary>)ViewBag.Beneficiaries;
}

<style>
    .transfer-page {
        padding: 15px 0 35px;
    }

    .bank-card {
        background: #fff;
        border: 1px solid #e5eaf0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(16, 42, 67, .08);
    }

    .bank-card-header {
        background: #102a43;
        color: white;
        padding: 23px;
        border-bottom: 4px solid #d4a84f;
    }

        .bank-card-header h4 {
            font-weight: 700;
            margin-bottom: 5px;
        }

        .bank-card-header p {
            color: #dbe5ef;
            font-size: 13px;
            margin: 0;
        }

    .bank-card-body {
        padding: 28px;
    }

    .transfer-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(212, 168, 79, .16);
        color: #d4a84f;
        border-radius: 12px;
        font-size: 24px;
    }

    .form-label {
        color: #102a43;
        font-size: 14px;
        font-weight: 600;
    }

    .form-control,
    .form-select {
        border: 1px solid #dce3eb;
        border-radius: 9px;
        padding: 11px 13px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #d4a84f;
            box-shadow: 0 0 0 .2rem rgba(212, 168, 79, .15);
        }

    .input-group-text {
        background: #f4f7fb;
        color: #102a43;
        border-color: #dce3eb;
        font-weight: 600;
    }

    .section-heading {
        color: #102a43;
        font-size: 15px;
        font-weight: 700;
        padding-bottom: 10px;
        margin-bottom: 20px;
        border-bottom: 1px solid #e5eaf0;
    }

    .beneficiary-box {
        background: #f4f7fb;
        border: 1px solid #e1e8f0;
        border-radius: 10px;
        padding: 15px;
    }

    .btn-bank {
        background: #102a43;
        color: white;
        border: 1px solid #102a43;
        border-radius: 8px;
        padding: 11px 24px;
        font-weight: 600;
    }

        .btn-bank:hover {
            background: #173f5f;
            color: white;
        }

    .btn-cancel {
        border: 1px solid #dce3eb;
        color: #475569;
        border-radius: 8px;
        padding: 11px 22px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #f4f7fb;
            color: #102a43;
        }

    .demo-notice {
        background: #fff8e8;
        border: 1px solid #f1dfb5;
        border-left: 4px solid #d4a84f;
        border-radius: 8px;
        padding: 12px 15px;
        color: #795b20;
        font-size: 13px;
    }

    .security-note {
        background: #f4f7fb;
        border-left: 4px solid #d4a84f;
        border-radius: 7px;
        padding: 13px 15px;
        color: #64748b;
        font-size: 13px;
    }

    .field-validation-error {
        font-size: 12px;
    }

    @@media (max-width: 576px) {
        .bank-card-body {
            padding: 19px;
        }

        .bank-card-header {
            padding: 18px;
        }

        .form-actions {
            flex-direction: column;
        }

            .form-actions button,
            .form-actions a {
                width: 100%;
                text-align: center;
            }
    }
</style>

<div class="container transfer-page">

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="bank-card">

                <!-- Header -->
                <div class="bank-card-header">

                    <div class="d-flex align-items-center gap-3">

                        <div class="transfer-icon">
                            <i class="bi bi-bank"></i>
                        </div>

                        <div>
                            <h4>Other Bank Transfer</h4>
                            <p>Transfer money to another bank account.</p>
                        </div>

                    </div>

                </div>

                <div class="bank-card-body">

                    <!-- Demo Notice -->
                    <div class="demo-notice mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Demo Mode:</strong>
                        Money is deducted from your SmartBank account.
                        No real external bank is contacted.
                    </div>

                    <form asp-action="OtherBank" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger py-2">
                        </div>

                        <!-- Sender Account -->
                        <h6 class="section-heading">
                            <i class="bi bi-wallet2 me-2"></i>
                            Sender Account
                        </h6>

                        <div class="mb-4">

                            <label asp-for="FromAccountId" class="form-label">
                                Your SmartBank Account
                            </label>

                            <select asp-for="FromAccountId"
                                    asp-items="@((SelectList)ViewBag.Accounts)"
                                    class="form-select">

                                <option value="">-- Select account --</option>

                            </select>

                            <span asp-validation-for="FromAccountId"
                                  class="text-danger field-validation-error">
                            </span>

                        </div>

                        <!-- Saved Beneficiary -->
                        @if (beneficiaries.Any())
                        {
                            <div class="beneficiary-box mb-4">

                                <label class="form-label">
                                    <i class="bi bi-person-check me-1"></i>
                                    Saved Beneficiary
                                </label>

                                <select id="benSelect" class="form-select">

                                    <option value="">-- Choose (optional) --</option>

                                    @foreach (var b in beneficiaries)
                                    {
                                        <option value="@b.AccountNumber"
                                                data-bank="@b.BankName"
                                                data-name="@b.Name">
                                            @b.Name - @b.BankName (@b.AccountNumber)
                                        </option>
                                    }

                                </select>

                                <small class="text-muted d-block mt-2">
                                    Select a saved beneficiary to fill account details automatically.
                                </small>

                            </div>
                        }

                        <!-- Receiver Details -->
                        <h6 class="section-heading mt-4">
                            <i class="bi bi-person-vcard me-2"></i>
                            Receiver Bank Details
                        </h6>

                        <div class="mb-4">

                            <label asp-for="BankName" class="form-label">
                                Receiving Bank
                            </label>

                            <select asp-for="BankName"
                                    asp-items="@((SelectList)ViewBag.Banks)"
                                    class="form-select">

                                <option value="">-- Select bank --</option>

                            </select>

                            <span asp-validation-for="BankName"
                                  class="text-danger field-validation-error">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="AccountNumber" class="form-label">
                                Account Number / IBAN
                            </label>

                            <input asp-for="AccountNumber"
                                   class="form-control"
                                   placeholder="Enter receiver account number" />

                            <span asp-validation-for="AccountNumber"
                                  class="text-danger field-validation-error">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="AccountTitle" class="form-label">
                                Account Holder Name
                            </label>

                            <input asp-for="AccountTitle"
                                   class="form-control"
                                   placeholder="Enter account holder name" />

                            <span asp-validation-for="AccountTitle"
                                  class="text-danger field-validation-error">
                            </span>

                        </div>

                        <!-- Payment Details -->
                        <h6 class="section-heading mt-4">
                            <i class="bi bi-cash-stack me-2"></i>
                            Payment Details
                        </h6>

                        <div class="mb-4">

                            <label asp-for="Amount" class="form-label">
                                Transfer Amount
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">Rs.</span>

                                <input asp-for="Amount"
                                       type="number"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="Enter amount" />
                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger field-validation-error">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Note" class="form-label">
                                Transfer Note
                            </label>

                            <input asp-for="Note"
                                   class="form-control"
                                   placeholder="Optional" />

                        </div>

                        <!-- Transaction PIN -->
                        <div class="mb-4">

                            <label asp-for="Pin" class="form-label">
                                <i class="bi bi-shield-lock me-1"></i>
                                Transaction PIN
                            </label>

                            <input asp-for="Pin"
                                   type="password"
                                   class="form-control"
                                   maxlength="4"
                                   autocomplete="off"
                                   placeholder="Enter 4-digit PIN"
                                   inputmode="numeric" />

                            <span asp-validation-for="Pin"
                                  class="text-danger field-validation-error">
                            </span>

                        </div>

                        <!-- Security Notice -->
                        <div class="security-note mb-4">
                            <i class="bi bi-shield-check text-success me-2"></i>
                            Please verify the receiving bank, account number and account title before sending money.
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex flex-wrap gap-2 form-actions">

                            <button type="submit" class="btn btn-bank">
                                <i class="bi bi-send-fill me-2"></i>
                                Send Money
                            </button>

                            <a class="btn-cancel"
                               asp-controller="Account"
                               asp-action="Index">
                                <i class="bi bi-arrow-left me-1"></i>
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        // Saved beneficiary choose karo to bank, number aur naam khud bhar jate hain
        $("#benSelect").on("change", function () {

            var opt = $(this).find("option:selected");

            if (!opt.val()) return;

            $("#BankName").val(opt.data("bank"));
            $("#AccountNumber").val(opt.val());
            $("#AccountTitle").val(opt.data("name"));
        });
    </script>
}