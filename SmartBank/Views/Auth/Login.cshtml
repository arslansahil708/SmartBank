@model SmartBank.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    .login-page {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
        background: linear-gradient(135deg, #eaf2ff, #f8fbff);
    }

    .login-card {
        width: 100%;
        max-width: 1000px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: white;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(10, 35, 75, 0.15);
    }

    .login-left {
        background: linear-gradient(145deg, #06264f, #104b83);
        color: white;
        padding: 65px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .bank-icon {
        font-size: 55px;
        color: #f5bd42;
        margin-bottom: 25px;
    }

    .login-left h1 {
        font-size: 38px;
        font-weight: 700;
        margin-bottom: 18px;
    }

        .login-left h1 span {
            color: #f5bd42;
        }

    .login-left p {
        font-size: 16px;
        line-height: 1.8;
        color: #dce9f8;
    }

    .feature {
        margin-top: 35px;
        line-height: 2.2;
        color: #f5bd42;
        font-weight: 500;
    }

    .login-right {
        padding: 55px 45px;
    }

    .login-heading {
        text-align: center;
        margin-bottom: 35px;
    }

        .login-heading h2 {
            color: #082b57;
            font-size: 34px;
            font-weight: 700;
        }

        .login-heading p {
            color: #718096;
        }

    .form-label {
        color: #17365d;
        font-weight: 600;
    }

    .login-input {
        height: 52px;
        border: 1px solid #d5deea;
        border-radius: 10px;
        padding: 12px 15px;
    }

        .login-input:focus {
            border-color: #dcae35;
            box-shadow: 0 0 0 3px rgba(220, 174, 53, 0.15);
        }

    .login-btn {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(90deg, #e9b83e, #f5ca63);
        color: #082b57;
        font-size: 18px;
        font-weight: 700;
        transition: 0.3s;
    }

        .login-btn:hover {
            background: #dca72e;
            transform: translateY(-2px);
        }

    .login-links {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 25px;
    }

        .login-links a {
            color: #1256a0;
            text-decoration: none;
            font-weight: 500;
        }

            .login-links a:hover {
                color: #d49d20;
                text-decoration: underline;
            }

    @@media (max-width: 768px) {
        .login-card {
            grid-template-columns: 1fr;
        }

        .login-left {
            padding: 35px 25px;
        }

            .login-left h1 {
                font-size: 30px;
            }

        .login-right {
            padding: 35px 25px;
        }
    }
</style>

<div class="login-page">
    <div class="login-card">

        <!-- Left Side -->
        <div class="login-left">

            <div class="bank-icon">
                <i class="bi bi-bank2"></i>
            </div>

            <h1>Welcome <span>Back!</span></h1>

            <p>
                Login to your SmartBank account and manage
                your finances securely, quickly and easily.
            </p>

            <div class="feature">
                <div><i class="bi bi-shield-lock-fill"></i> Secure Banking</div>
                <div><i class="bi bi-lightning-fill"></i> Fast Transactions</div>
                <div><i class="bi bi-headset"></i> 24/7 Banking Access</div>
            </div>

        </div>

        <!-- Right Side -->
        <div class="login-right">

            <div class="login-heading">
                <h2>Login</h2>
                <p>Access your SmartBank account</p>
            </div>

            <form asp-action="Login" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control login-input"
                           placeholder="Enter your email"
                           autocomplete="username" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control login-input"
                           placeholder="Enter your password"
                           autocomplete="current-password" />

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit" class="login-btn">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Login to SmartBank
                </button>

                <div class="login-links">

                    <a asp-action="Register">
                        <i class="bi bi-person-plus-fill"></i>
                        Create Account
                    </a>

                    <a asp-action="ForgotPassword">
                        <i class="bi bi-question-circle-fill"></i>
                        Forgot Password?
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}