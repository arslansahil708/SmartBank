@model SmartBank.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    .forgot-page {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
        background: linear-gradient(135deg, #eaf2ff, #f8fbff);
    }

    .forgot-card {
        width: 100%;
        max-width: 950px;
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        background: white;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(10, 35, 75, 0.15);
    }

    .forgot-left {
        background: linear-gradient(145deg, #06264f, #104b83);
        color: white;
        padding: 55px 38px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .forgot-icon {
        font-size: 65px;
        color: #f5bd42;
        margin-bottom: 25px;
    }

    .forgot-left h2 {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 18px;
    }

        .forgot-left h2 span {
            color: #f5bd42;
        }

    .forgot-left p {
        color: #dce9f8;
        line-height: 1.8;
    }

    .forgot-features {
        margin-top: 25px;
        color: #f5bd42;
        line-height: 2.5;
    }

    .forgot-right {
        padding: 60px 45px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .forgot-heading {
        text-align: center;
        margin-bottom: 30px;
    }

        .forgot-heading h2 {
            color: #082b57;
            font-size: 32px;
            font-weight: 700;
        }

        .forgot-heading p {
            color: #718096;
            line-height: 1.7;
        }

    .form-label {
        color: #17365d;
        font-weight: 600;
    }

    .forgot-input {
        height: 52px;
        border: 1px solid #d5deea;
        border-radius: 10px;
        padding: 12px 15px;
    }

        .forgot-input:focus {
            border-color: #dcae35;
            box-shadow: 0 0 0 3px rgba(220, 174, 53, 0.15);
        }

    .forgot-btn {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(90deg, #e9b83e, #f5ca63);
        color: #082b57;
        font-size: 17px;
        font-weight: 700;
        transition: 0.3s;
    }

        .forgot-btn:hover {
            background: #dca72e;
            transform: translateY(-2px);
        }

    .back-login {
        text-align: center;
        margin-top: 25px;
    }

        .back-login a {
            color: #1256a0;
            text-decoration: none;
            font-weight: 600;
        }

            .back-login a:hover {
                color: #d49d20;
                text-decoration: underline;
            }

    .security-note {
        background: #f0f5fc;
        border-radius: 10px;
        padding: 13px;
        margin-bottom: 25px;
        color: #315477;
        font-size: 14px;
    }

    @@media (max-width: 768px) {
        .forgot-card {
            grid-template-columns: 1fr;
        }

        .forgot-left {
            padding: 35px 25px;
        }

        .forgot-right {
            padding: 35px 25px;
        }
    }
</style>

<div class="forgot-page">

    <div class="forgot-card">

        <!-- Left Side -->
        <div class="forgot-left">

            <div class="forgot-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <h2>Account <span>Recovery</span></h2>

            <p>
                Forgot your password? Don't worry.
                We will help you securely recover access
                to your SmartBank account.
            </p>

            <div class="forgot-features">
                <div>
                    <i class="bi bi-shield-check"></i>
                    Secure Verification
                </div>

                <div>
                    <i class="bi bi-phone-fill"></i>
                    Mobile OTP Verification
                </div>

                <div>
                    <i class="bi bi-lock-fill"></i>
                    Protected Account
                </div>
            </div>

        </div>

        <!-- Right Side -->
        <div class="forgot-right">

            <div class="forgot-heading">
                <h2>Forgot Password?</h2>
                <p>
                    Enter your registered email address.
                    We will send a 6-digit OTP to your
                    registered mobile number.
                </p>
            </div>

            <div class="security-note">
                <i class="bi bi-info-circle-fill me-2"></i>
                Make sure you enter the email linked
                to your SmartBank account.
            </div>

            <form asp-action="ForgotPassword" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-4">

                    <label asp-for="Email" class="form-label">
                        Registered Email Address
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control forgot-input"
                           placeholder="Enter your registered email"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit" class="forgot-btn">
                    <i class="bi bi-send-fill me-2"></i>
                    Send OTP
                </button>

                <div class="back-login">
                    <a asp-action="Login">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Login
                    </a>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}