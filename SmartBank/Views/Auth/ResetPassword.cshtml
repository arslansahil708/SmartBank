@model SmartBank.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<style>
    .reset-page {
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
        background: linear-gradient(135deg, #eaf2ff, #f8fbff);
    }

    .reset-card {
        width: 100%;
        max-width: 1000px;
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        background: white;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(10, 35, 75, 0.15);
    }

    .reset-left {
        background: linear-gradient(145deg, #06264f, #104b83);
        color: white;
        padding: 50px 38px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .reset-icon {
        font-size: 65px;
        color: #f5bd42;
        margin-bottom: 25px;
    }

    .reset-left h2 {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 18px;
    }

        .reset-left h2 span {
            color: #f5bd42;
        }

    .reset-left p {
        color: #dce9f8;
        line-height: 1.8;
    }

    .reset-features {
        margin-top: 25px;
        color: #f5bd42;
        line-height: 2.5;
        font-weight: 500;
    }

    .reset-right {
        padding: 45px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .reset-heading {
        text-align: center;
        margin-bottom: 25px;
    }

        .reset-heading h2 {
            color: #082b57;
            font-size: 32px;
            font-weight: 700;
        }

        .reset-heading p {
            color: #718096;
        }

    .form-label {
        color: #17365d;
        font-weight: 600;
    }

    .reset-input {
        height: 50px;
        border: 1px solid #d5deea;
        border-radius: 10px;
        padding: 12px 15px;
    }

        .reset-input:focus {
            border-color: #dcae35;
            box-shadow: 0 0 0 3px rgba(220, 174, 53, 0.15);
        }

    .reset-btn {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(90deg, #e9b83e, #f5ca63);
        color: #082b57;
        font-size: 17px;
        font-weight: 700;
        transition: 0.3s;
    }

        .reset-btn:hover {
            background: #dca72e;
            transform: translateY(-2px);
        }

    .demo-otp {
        border-radius: 10px;
        padding: 15px;
        background: #fff8e5;
        border: 1px solid #f1d58a;
        color: #74520a;
        margin-bottom: 22px;
    }

        .demo-otp strong {
            color: #a36b00;
            letter-spacing: 2px;
        }

    .back-login {
        text-align: center;
        margin-top: 22px;
    }

        .back-login a {
            color: #1256a0;
            text-decoration: none;
            font-weight: 600;
        }

            .back-login a:hover {
                color: #d49d20;
                text-decoration: underline;
            }

    @@media (max-width: 768px) {
        .reset-card {
            grid-template-columns: 1fr;
        }

        .reset-left {
            padding: 35px 25px;
        }

        .reset-right {
            padding: 30px 22px;
        }
    }
</style>

<div class="reset-page">

    <div class="reset-card">

        <!-- Left Side -->
        <div class="reset-left">

            <div class="reset-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <h2>Reset <span>Password</span></h2>

            <p>
                Create a new password to restore access
                to your SmartBank account. Verify your
                identity using the OTP sent to your mobile.
            </p>

            <div class="reset-features">

                <div>
                    <i class="bi bi-phone-fill"></i>
                    OTP Verification
                </div>

                <div>
                    <i class="bi bi-lock-fill"></i>
                    Secure Password
                </div>

                <div>
                    <i class="bi bi-shield-check"></i>
                    Account Protection
                </div>

            </div>

        </div>

        <!-- Right Side -->
        <div class="reset-right">

            <div class="reset-heading">
                <h2>New Password</h2>
                <p>Verify OTP and create your new password</p>
            </div>

            @* DEMO: Real SMS provider nahi hai, is liye OTP yahan show hota hai. *@

            @if (TempData["DemoOtp"] != null)
            {
                <div class="demo-otp">

                    <div class="mb-2">
                        <i class="bi bi-chat-dots-fill me-2"></i>
                        <strong>Demo SMS Verification</strong>
                    </div>

                    Your SmartBank OTP is:

                    <strong>@TempData["DemoOtp"]</strong>

                    <div class="small mt-2">
                        <i class="bi bi-clock"></i>
                        Valid for 5 minutes.
                    </div>

                </div>
            }

            <form asp-action="ResetPassword" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- Email -->
                <div class="mb-3">

                    <label asp-for="Email" class="form-label">
                        Registered Email
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control reset-input"
                           placeholder="Enter your email"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <!-- OTP -->
                <div class="mb-3">

                    <label asp-for="Otp" class="form-label">
                        6-Digit OTP
                    </label>

                    <input asp-for="Otp"
                           class="form-control reset-input"
                           maxlength="6"
                           inputmode="numeric"
                           placeholder="Enter 6-digit OTP"
                           autocomplete="one-time-code" />

                    <span asp-validation-for="Otp"
                          class="text-danger">
                    </span>

                </div>

                <!-- New Password -->
                <div class="mb-3">

                    <label asp-for="NewPassword" class="form-label">
                        New Password
                    </label>

                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control reset-input"
                           placeholder="Enter new password"
                           autocomplete="new-password" />

                    <span asp-validation-for="NewPassword"
                          class="text-danger">
                    </span>

                </div>

                <!-- Confirm Password -->
                <div class="mb-4">

                    <label asp-for="ConfirmPassword" class="form-label">
                        Confirm New Password
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control reset-input"
                           placeholder="Confirm new password"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit" class="reset-btn">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Change Password
                </button>

                <div class="back-login">

                    <a asp-action="Login">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Login
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}