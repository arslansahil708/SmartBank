@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    body {
        background: #f1f5ff;
    }

    .dashboard-container {
        max-width: 1250px;
        margin: 35px auto;
        padding: 15px;
    }

    .dashboard-header {
        background: linear-gradient(120deg, #061d43, #07509a);
        color: white;
        padding: 35px;
        border-radius: 18px;
        border-bottom: 5px solid #e7b94f;
        margin-bottom: 30px;
        box-shadow: 0 8px 25px rgba(8, 35, 75, 0.12);
    }

        .dashboard-header h2 {
            font-weight: 750;
            margin-bottom: 8px;
        }

        .dashboard-header p {
            color: #dce8ff;
            margin: 0;
        }

    .header-icon {
        font-size: 55px;
        color: #f3c65e;
    }

    .dashboard-card {
        background: white;
        border: 1px solid #e0e8f8;
        border-radius: 17px;
        padding: 23px;
        height: 100%;
        box-shadow: 0 5px 20px rgba(8, 35, 75, 0.06);
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(8, 35, 75, 0.12);
            border-color: #d5a63b;
        }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .card-label {
        color: #718096;
        font-size: 14px;
        font-weight: 600;
    }

    .card-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 27px;
    }

    .icon-blue {
        background: #e9f0ff;
        color: #1451a0;
    }

    .icon-green {
        background: #e1f8eb;
        color: #087b46;
    }

    .icon-gold {
        background: #fff5d9;
        color: #bd8b1c;
    }

    .icon-red {
        background: #ffe8e8;
        color: #dc3545;
    }

    .icon-purple {
        background: #f0eaff;
        color: #7043b5;
    }

    .card-number {
        color: #09244d;
        font-size: 30px;
        font-weight: 800;
        margin-bottom: 18px;
        overflow-wrap: anywhere;
    }

    .card-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #1451a0;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        transition: 0.2s;
    }

        .card-link:hover {
            color: #bd8b1c;
            gap: 12px;
        }

        .card-link i {
            font-size: 17px;
        }

    .dashboard-section-title {
        color: #09244d;
        font-weight: 750;
        margin-bottom: 20px;
    }

        .dashboard-section-title i {
            color: #d6a32e;
            margin-right: 8px;
        }

    .dashboard-footer {
        background: white;
        border: 1px solid #e0e8f8;
        border-radius: 14px;
        padding: 17px 22px;
        margin-top: 25px;
        color: #718096;
        font-size: 13px;
    }

    @@media (max-width: 768px) {
        .dashboard-header {
            padding: 23px;
        }

            .dashboard-header h2 {
                font-size: 24px;
            }

        .header-icon {
            font-size: 40px;
        }

        .dashboard-card {
            padding: 20px;
        }

        .card-number {
            font-size: 26px;
        }
    }
</style>

<div class="container dashboard-container">

    <!-- Dashboard Header -->
    <div class="dashboard-header">

        <div class="d-flex align-items-center gap-4">

            <i class="bi bi-speedometer2 header-icon"></i>

            <div>
                <h2>Admin Dashboard</h2>

                <p>
                    <i class="bi bi-shield-check me-1"></i>
                    Welcome to SmartBank Administration Panel
                </p>
            </div>

        </div>

    </div>

    <!-- Section Heading -->
    <h5 class="dashboard-section-title">
        <i class="bi bi-grid-fill"></i>
        Banking Overview
    </h5>

    <!-- Dashboard Cards -->
    <div class="row g-4">

        <!-- Customers -->
        <div class="col-md-6 col-lg-4">

            <div class="dashboard-card">

                <div class="card-top">
                    <span class="card-label">Total Customers</span>

                    <div class="card-icon icon-blue">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>

                <h3 class="card-number">
                    @ViewBag.Customers
                </h3>

                <a asp-action="Customers" class="card-link">
                    Manage Customers
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

        <!-- Accounts -->
        <div class="col-md-6 col-lg-4">

            <div class="dashboard-card">

                <div class="card-top">
                    <span class="card-label">Total Accounts</span>

                    <div class="card-icon icon-green">
                        <i class="bi bi-bank"></i>
                    </div>
                </div>

                <h3 class="card-number">
                    @ViewBag.Accounts
                </h3>

                <a asp-action="Accounts" class="card-link">
                    Manage Accounts
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

        <!-- Deposits -->
        <div class="col-md-6 col-lg-4">

            <div class="dashboard-card">

                <div class="card-top">
                    <span class="card-label">Total Deposits</span>

                    <div class="card-icon icon-gold">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>

                <h3 class="card-number">
                    Rs @(((decimal)ViewBag.TotalDeposits).ToString("N2"))
                </h3>

                <a asp-action="Reports" class="card-link">
                    View Reports
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

        <!-- Pending Loans -->
        <div class="col-md-6 col-lg-4">

            <div class="dashboard-card">

                <div class="card-top">
                    <span class="card-label">Pending Loan Applications</span>

                    <div class="card-icon icon-red">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>

                <h3 class="card-number">
                    @ViewBag.PendingLoans
                </h3>

                <a asp-action="Loans" class="card-link">
                    Review Applications
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

        <!-- Pending Requests -->
        <div class="col-md-6 col-lg-4">

            <div class="dashboard-card">

                <div class="card-top">
                    <span class="card-label">Pending Service Requests</span>

                    <div class="card-icon icon-purple">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                </div>

                <h3 class="card-number">
                    @ViewBag.PendingRequests
                </h3>

                <a asp-action="Requests" class="card-link">
                    Process Requests
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

        <!-- Transactions Today -->
        <div class="col-md-6 col-lg-4">

            <div class="dashboard-card">

                <div class="card-top">
                    <span class="card-label">Transactions Today</span>

                    <div class="card-icon icon-green">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                </div>

                <h3 class="card-number">
                    @ViewBag.TodayTransactions
                </h3>

                <a asp-action="Transactions" class="card-link">
                    View Transactions
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

    </div>

    <!-- Footer -->
    <div class="dashboard-footer">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">

            <span>
                <i class="bi bi-shield-lock-fill text-primary me-2"></i>
                SmartBank Administration System
            </span>

            <span>
                <i class="bi bi-check-circle-fill text-success me-1"></i>
                Secure Admin Panel
            </span>

        </div>

    </div>

</div>